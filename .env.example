# Copy to .env locally; never commit a populated .env. Use a secrets manager in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=pglite:./data/development
DB_POOL_MAX=12
DB_SSL=disable
# Random cookie signing secret, >=32 characters; openssl rand -hex 48
COOKIE_SECRET=
# Random AES-256-GCM key; openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_HOURS=12
TRUST_PROXY=false
ENABLE_DEMO=false
LOG_LEVEL=info
METRICS_TOKEN=
SENTRY_DSN=
# Explicit one-time bootstrap credentials. Remove from deployed environment afterwards.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_MOBILE=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_MFA_SECRET=
DEV_DEMO_PASSWORD=
# Production Compose only (URL-encode reserved characters in passwords)
DEPLOYMENT_ENV=production
APP_HOST=
POSTGRES_PASSWORD=
# Integration settings: confirm adapter-supported names in docs/production/INTEGRATIONS.md.
PAYMENT_PROVIDER=myfatoorah
MYFATOORAH_API_KEY=
MYFATOORAH_ENVIRONMENT=sandbox
MYFATOORAH_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STORAGE_DIR=./data/uploads
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

SMTP_SECURE=false

# Separate restricted PostgreSQL runtime role (32+ random URL-safe characters)
DB_APP_PASSWORD=
TWILIO_WHATSAPP_FROM=
OPERATIONS_EMAIL=
# Supplier payouts use an explicitly implemented bank/marketplace bridge contract.
# A bridge is not a native bank connection; see docs/production/SUPPLIER-SETTLEMENTS.md.
SUPPLIER_PAYOUT_PROVIDER=
SUPPLIER_PAYOUT_ENVIRONMENT=sandbox
SUPPLIER_PAYOUT_BASE_URL=
SUPPLIER_PAYOUT_API_KEY=
SUPPLIER_PAYOUT_WEBHOOK_SECRET=
# IDs or links from completed operational reviews
SANDBOX_CERTIFICATION_REFERENCE=
RESTORE_DRILL_REFERENCE=
SECURITY_REVIEW_REFERENCE=

# Optional fallback/bootstrap configuration; service credentials can be saved in /admin/integrations.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TWILIO_WHATSAPP_CONTENT_SID=
ESIGNATURE_MODE=clickwrap
ESIGNATURE_BASE_URL=
ESIGNATURE_SIGNING_ORIGIN=
ESIGNATURE_API_KEY=
ESIGNATURE_WEBHOOK_SECRET=
